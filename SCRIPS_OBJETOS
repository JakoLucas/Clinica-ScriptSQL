CREATE OR ALTER PROCEDURE SP_AgregarTurnos
    @IDClinica SMALLINT,
    @IDPaciente SMALLINT,
    @IDMedico SMALLINT,
    @IDUsuario SMALLINT,
    @FechaTurno DATE,
    @HoraTurno TIME
AS
BEGIN

    DECLARE @PrecioPlan DECIMAL(10,2);
    DECLARE @Copago DECIMAL(10,2);
    DECLARE @EstadoTurno VARCHAR(20);

    IF NOT EXISTS (
        SELECT 1
        FROM Pacientes
        WHERE IDPaciente = @IDPaciente
    )
    BEGIN
        RAISERROR ('El paciente no existe.', 16,1);
        RETURN;
    END;

    IF NOT EXISTS (
        SELECT 1
        FROM Medicos
        WHERE IDMedico = @IDMedico
          AND IDClinica = @IDClinica
    )
    BEGIN
        RAISERROR ('El medico no pertenece a la clinica seleccionada.', 16,1);
        RETURN;
    END;

    IF NOT EXISTS (
        SELECT 1
        FROM Usuarios
        WHERE IDUsuario = @IDUsuario
    )
    BEGIN
        RAISERROR ('El usuario no existe.', 16,1);
        RETURN;
    END;

    SELECT @PrecioPlan = P.Precio
    FROM Pacientes PA
    INNER JOIN Planes P ON PA.IDPlan = P.IDPlan
    WHERE PA.IDPaciente = @IDPaciente;

    IF @PrecioPlan IS NULL OR @PrecioPlan = 0
    BEGIN
    RAISERROR ('El paciente no tiene plan.', 16,1);
    RETURN;
    END;
    IF @PrecioPlan < 20000
    BEGIN
        SET @Copago = 5000;
        SET @EstadoTurno = 'Pendiente';
    END
    ELSE
    BEGIN
        SET @Copago = 0;
        SET @EstadoTurno = 'Confirmado';
    END;

    ---------------------------------------------------Registrar el turno

    INSERT INTO Turnos(IDClinica,IDPaciente,IDMedico,IDUsuario, EstadoTurno,Copago,FechaTurno,HoraTurno)
    VALUES(@IDClinica,@IDPaciente,@IDMedico,@IDUsuario,@EstadoTurno,@Copago,@FechaTurno,@HoraTurno);

    IF @EstadoTurno = 'Pendiente'
BEGIN
    PRINT 'Turno registrado correctamente.';
    PRINT 'ATENCION: El turno queda pendiente de pago.';
    PRINT 'Copago a abonar: $' + CAST(@Copago AS VARCHAR(20));
END
ELSE
BEGIN
    PRINT 'Turno registrado correctamente.';
    PRINT 'El turno queda confirmado. No requiere copago.';
    END
END;

