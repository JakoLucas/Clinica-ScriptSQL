CREATE OR ALTER  VIEW VW_TurnosSolicitados as
select
 C.NombreClinica COLLATE Latin1_General_100_CI_AI AS Clinica,
CONCAT(M.Nombre, ' ', M.Apellido) AS Medico,
E.NombreEspecialidad as Especialidad,
COUNT(T.IDTurno) as CantTurno,
T.FechaTurno as Fecha,
T.EstadoTurno as Estado
 from Turnos T
inner join  Medicos M
on T.IDMedico=M.IDMedico
inner join Especialidades E
on M.IDEspecialidad=E.IDEspecialidad
inner join Clinicas C
on M.IDClinica=C.IDClinica   

GROUP BY 
 M.Nombre, M.Apellido,
E.NombreEspecialidad,
C.NombreClinica,
T.FechaTurno,
T.EstadoTurno;
